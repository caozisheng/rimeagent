{
  "name": "rimeagent",
  "version": "0.5.0",
  "private": false,
  "description": "Host-agnostic LLM agent engine with tool registry, streaming, and expert role orchestration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./backends/vercel": {
      "types": "./dist/adapters/vercel.d.ts",
      "import": "./dist/adapters/vercel.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:core": "tsc --project tsconfig.core.json",
    "dev": "tsc --watch --project tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "npm run build",
    "test": "bun test",
    "typecheck": "tsc --project tsconfig.test.json"
  },
  "dependencies": {
    "nanoid": "^5.1.5"
  },
  "peerDependencies": {
    "ai": ">=5"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^2",
    "@types/bun": "^1.4.2",
    "ai": "^5",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "llm",
    "agent",
    "tool-calling",
    "streaming",
    "openai-compatible"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/caozisheng/rimeagent.git"
  }
}
